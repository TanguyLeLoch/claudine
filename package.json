{
  "name": "claudine",
  "version": "1.0.0",
  "description": "Claudine Desktop Application",
  "main": "dist/electron/main.js",
  "homepage": "https://github.com/tanguyleloch/claudine",
  "author": {
    "name": "Tanguy Le Loch",
    "email": "tanguylelochpro@gmail.com"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "electron": "npm run build:electron && electron dist/electron/main.js --dev",
    "build": "ng build --base-href ./",

    "build:electron": "tsc -p tsconfig.electron.json && npm run copyfile",
    "copyfile": "copyfiles -f electron/text-processor/selection-overlay.html dist/electron/text-processor",

    "build:all-parts": "npm run build && npm run build:electron",
    "test": "ng test",
    "build:current": "npm run build:all-parts && electron-builder",
    "build:mac": "npm run build:all-parts && electron-builder --mac",
    "build:win": "npm run build:all-parts && electron-builder --win",
    "build:linux": "npm run build:all-parts && electron-builder --linux",
    "build:all": "npm run build:all-parts && electron-builder --mac --win --linux"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@google/generative-ai": "^0.21.0",
    "@nut-tree-fork/nut-js": "^4.2.3",
    "@primeuix/themes": "^1.2.4",
    "@tailwindcss/postcss": "^4.1.12",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^10.0.0",
    "postcss": "^8.5.6",
    "primeicons": "^7.0.0",
    "primeng": "^20.2.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.12",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.4.21",
    "copyfiles": "^2.4.1",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "onchange": "^7.1.0",
    "typescript": "~5.8.2"
  },
  "build": {
    "appId": "com.example.claudine",
    "productName": "Claudine",
    "icon": "assets/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "dist/claudine/browser/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "electron/text-processor/selection-overlay.html",
        "to": "electron/text-processor/selection-overlay.html"
      },
      {
        "from": "electron/text-processor/selection-preload.js",
        "to": "electron/text-processor/selection-preload.js"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "maintainer": "Your Name <your.email@example.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
